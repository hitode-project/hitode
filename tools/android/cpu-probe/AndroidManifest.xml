<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.advhost.cpuprobe"
    android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="36" />
    <application android:label="ADV CPU Probe" android:hasCode="true" android:debuggable="true"
        android:extractNativeLibs="false" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
