{
  "version": 1,
  "dll": "fixture_export_probe.dll",
  "buffers": [
    {"id": "state", "size": 16, "words": [10, 0, 0, 0]},
    {"id": "pixels", "size": 256, "fill": 90},
    {"id": "slot", "size": 4}
  ],
  "calls": [
    {"id": "add", "export": "Add", "abi": "stdcall", "args": ["0xffffffff", 2], "iterations": 1000, "expect": 1},
    {"id": "pointer", "export": "Identity", "abi": "cdecl", "args": [{"buffer": "state"}], "return": "pointer"},
    {"id": "advance", "export": "Advance", "abi": "thiscall", "this": {"result": "pointer"}, "args": [3], "warmup": 2, "iterations": 10, "expect": 46},
    {"id": "indirect", "export": "Indirect", "abi": "cdecl", "writes": [{"buffer": "slot", "words": [{"buffer": "state"}]}], "args": [{"buffer": "slot"}, {"read": "state"}], "expect": 92, "hashes": [{"buffer": "state"}, {"buffer": "pixels"}]},
    {"id": "wide", "export": 5, "abi": "cdecl", "args": ["0x12345678", "0x9abcdef0"], "return": "u64", "hashes": [{"buffer": "state"}]},
    {"id": "noargs", "export": "NoArgs", "abi": "cdecl", "iterations": 1000, "expect": 37, "hashes": [{"buffer": "state"}]},
    {"id": "fold", "export": "Fold", "abi": "cdecl", "args": [{"buffer": "pixels", "offset": 16}, 224, "0x12345678"], "warmup": 1, "iterations": 101, "hashes": [{"buffer": "pixels", "offset": 16, "size": 224}]}
  ]
}
