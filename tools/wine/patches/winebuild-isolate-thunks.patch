@@ -584,11 +587,39 @@
 
     if (!needs_imports) return;
     output( "\t.text\n" );
+    if (!needs_isolate)
+    {
+        output_import_thunks( exports, 0 );
+        return;
+    }
+    /* Each group starts on a page of its own, and the code after the thunks
+     * shares no page with them. A program that makes one thunk's page
+     * writable and then calls an -isolate thunk to restore it still finds
+     * that thunk executable. */
+    output( "\t.balign 4096\n" );
+    output_import_thunks( exports, FLAG_ISOLATE );
+    output( "\t.balign 4096\n" );
+    output_import_thunks( exports, 0 );
+    output( "\t.balign 4096\n" );
+}
+
+
+/*******************************************************************
+ *         output_import_thunks
+ *
+ * Output the import thunks whose FLAG_ISOLATE bit equals isolate.
+ */
+static void output_import_thunks( struct exports *exports, int isolate )
+{
+    const char *name;
+    int i;
+
     for (i = exports->base; i <= exports->limit; i++)
     {
         ORDDEF *odp = exports->ordinals[i];
         if (!odp) continue;
         if (!(odp->flags & FLAG_IMPORT)) continue;
+        if ((odp->flags & FLAG_ISOLATE) != isolate) continue;
 
         name = odp->name ? odp->name : odp->export_name;
 
