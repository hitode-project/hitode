{
  "spec": ["A64-TR-9", "A64-OPT-8", "A64-OPT-9"],
  "exe": "threaded_x87_blocks.exe",
  "args": ["--sync-compilation"],
  "seconds": 120,
  "outputs": ["threaded-x87-blocks.bin"],
  "min": {
    "split_proofs": 1
  },
  "steady": {
    "iterations": [2, 4],
    "regions": ["_warp_rows", "_block_trunc", "_blend_band"],
    "split_policy": "_blend_band",
    "counters": ["interprets", "accesses", "resident_cold_exits"]
  }
}
