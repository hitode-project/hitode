{
  "spec": ["A64-TR-9", "A64-OPT-8", "A64-OPT-9"],
  "exe": "threaded_x87_blocks.exe",
  "args": ["--sync-compilation"],
  "seconds": 60,
  "outputs": ["threaded-x87-blocks.bin"],
  "min": {
    "split_proofs": 1,
    "splits": 4,
    "split_retired": 200000000,
    "whole_worker_jobs": 500,
    "worker_retired": 100000000
  },
  "steady": {
    "iterations": [4, 8],
    "counters": ["retired", "interprets", "accesses", "resident_cold_exits"]
  }
}
