# The repository stores LF; every checkout uses LF too, so scripts and editors
# never meet mixed line endings.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Zero-argument ABI declarations retain an empty final TSV parameter column.
/data/abi/*.tsv whitespace=-blank-at-eol

# Recorded fixture executables and native outputs (tools/fixtures/record_native.py).
/tools/fixtures/native/**/*.exe binary
/tools/fixtures/native/**/*.bin binary

# Vendored Wine sources stay byte-identical to the upstream release.
/vendor/wine/** -whitespace
/vendor/wine/nls/*.nls binary

# Bundled General MIDI SoundFont.
/vendor/fluidr3mono/*.sf3 binary
